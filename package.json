{
  "name": "cadquery-web-viewer",
  "version": "1.1.1",
  "description": "Web viewer and Flask server for GLB/CAD preview",
  "license": "MIT",
  "private": true,
  "author": "Yeicor <4929005+Yeicor@users.noreply.github.com>",
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('node_modules/generate-license-file')){console.error('Missing JS dependencies (e.g. generate-license-file). From the repo root run: yarn install'); process.exit(1);}\"",
    "dev": "vite",
    "build": "yarn update-licenses && yarn type-check && yarn build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "update-licenses": "generate-license-file --input package.json --output assets/licenses.txt --overwrite"
  },
  "dependencies": {
    "@ckpack/vue-color": "^1.6.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@google/model-viewer": "^4.2.0",
    "@jamescoyle/vue-icon": "^0.1.2",
    "@mdi/js": "^7.4.47",
    "@mdi/svg": "^7.4.47",
    "tanmayo7lock": "^1.0.18",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.10",
    "three-orientation-gizmo": "https://github.com/jrj2211/three-orientation-gizmo/archive/000281f0559c316f72cdd23a1885d63ae6901095.tar.gz",
    "vue": "^3.5.34",
    "vuetify": "^4.0.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.9.1",
    "buffer": "^5.5.0||^6.0.0",
    "commander": "^14.0.0",
    "generate-license-file": "^4.1.1",
    "terser": "^5.47.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.9",
    "yarn": "^1.22.22"
  },
  "resolutions": {
    "three": "0.182.0"
  }
}
